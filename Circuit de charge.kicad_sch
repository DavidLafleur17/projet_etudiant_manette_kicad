	)
	(text "// ========== MCP73871 ========== //\n\nIN : V_{REG} + 0.3V to 6V, bypass to V_{SS} 4.7uF minimum\n\nOUT : Prioritizes V_{IN} to OUT, bypass to V_{SS} 4.7uF minimum\n\nVPCC : 1.23V or greater to the pin → battery charging current drops if V_{IN} drops below threshold\n	   V_{IN} connected to the pin → disables this feature\n\nSEL : HIGH → 1.65A max OUT, 1.8A max V_{IN}\n      LOW → USB port input mode\n\nV_{SS} : Negative terminal of the battery, system load and input supply\n\nV_{BAT} : Positive terminal of Li-Ion battery, bypass to V_{SS} 4.7uF\n\nV_{BAT_SENSE} : Positive terminal of battery, internal regulation voltage to V_{REG}\n\nPROG1 : Maximum constant charge current set by PROG1 → R_{S} → V_{SS}\n\nPROG2 : USB port regulation input, LOW → 100mA / HIGH → 500mA\n\nSTAT1/~{LBO} : Battery status indication, V_{IN} → LED → R_{S} → STAT1 / STAT1 → pull-up → GPIO\n\nSTAT2 : Charge status indication, LOW → Charge complete, V_{IN} → LED → R_{S} → STAT2 / STAT2 → pull-up → GPIO\n\n~{PG} : Power supply status indication, V_{IN} → LED → R_{S} → ~{PG} / ~{PG} → pull-up → GPIO"
		(exclude_from_sim no)
		(at 112.776 -41.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "31c2a178-d6fb-424a-abd6-f99d52276552")
	)
	(text "Sur boîtier"
		(exclude_from_sim no)
		(at 205.994 67.564 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "9c7a91f8-8e09-4bf7-ba41-cd4f6d952328")
	)
	(text "SEL : Low for USB\n\nPROG1 : 1000V/R = I (to Bat/Load)\nPROG2 : USB input current limit (when SEL low), high = 500mA / low = 100mA\nPROG3 : 1000V/R = I (when below I, stop charging when in constant voltage)\n~{TE} : Enable timer when low\nCE : Enable high"
		(exclude_from_sim no)
		(at 189.23 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ab047512-34f2-49ba-b74e-772a66327235")
	)
	(text "VPCC → if IN is lower than V_{VPCC}, battery charging current reduced\n\nSEL → LOW = USB\n\nPROG1 → 1000V/R_{PROG1} = I_{REG} (fast charge current regulation set)\n        → 2500Ω = 400mA\n\nPROG2 → HIGH = 500mA from USB\n\nPROG3 → 1000V/R_{PROG3} = I_{TERMINATION} (charge termination)\n        → 25kΩ = 40mA (10% of I_{REG})\n\n~{TE} → LOW = timer enabled\n\nCE → HIGH = chip enabled"
		(exclude_from_sim no)
		(at 21.844 141.986 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e82bb0fb-b788-4700-b542-a00c58331ae5")
	)
